{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "Android/MMKV/**",
        ".github/workflows/**"
      ],
      "enabled": true
    },
    {
      "matchFileNames": [
        "!Android/MMKV/**",
        "!.github/workflows/**"
      ],
      "enabled": false
    }
  ]
}
