{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>goooler/renovate-config:default.json5',
  ],
  "packageRules": [
    {
      groupName: 'AGP',
      matchPackageNames: [
        '/com.android.*/',
      ],
    },
    {
      "matchFileNames": [
        "!Android/MMKV/**",
        "!.github/workflows/**"
      ],
      "enabled": false,
    }
  ]
}
